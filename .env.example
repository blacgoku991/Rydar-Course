# =============================================================================
# RYDAR Privé — variables d'environnement
# Sur Vercel : Project → Settings → Environment Variables (puis "Redeploy").
# En local : copiez ce fichier en .env.local
# =============================================================================

# --- 1. Indispensable ---------------------------------------------------------
# Longue chaîne aléatoire (32+ caractères). Sert à signer les devis et protège /setup.
# Générer : openssl rand -hex 32
APP_SECRET=

# Adresse publique du site, sans "/" final (ex. https://www.rydarprive.com).
# Sur Vercel, le domaine de production est détecté automatiquement si vide.
NEXT_PUBLIC_SITE_URL=

# --- 2. Centrale Telegram -----------------------------------------------------
# Jeton donné par @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# ID du groupe centrale : ajoutez le bot au groupe et tapez /id (commence souvent par -100…)
TELEGRAM_CHAT_ID=
# Facultatif : sujet d'un groupe "forum" où poster les courses
TELEGRAM_THREAD_ID=
# Facultatif : IDs Telegram autorisés à annuler/libérer (en plus des admins du groupe), séparés par des virgules
TELEGRAM_ADMIN_IDS=

# --- 3. Contact affiché sur le site -------------------------------------------
# Numéro de l'assistant téléphonique / de la centrale, tel qu'affiché
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_EMAIL=
# Numéro WhatsApp (facultatif), format international
NEXT_PUBLIC_WHATSAPP=

# --- 4. Votre activité --------------------------------------------------------
# Commission de la centrale en % du prix client (affichée seulement dans Telegram)
COMMISSION_PERCENT=20
# Délai minimum de réservation en minutes
MIN_LEAD_MINUTES=120
# Texte lu par l'assistant au sujet du paiement (facultatif, en anglais ou français)
PAYMENT_INFO=

# --- 5. Assistant téléphonique (ElevenLabs + Twilio) --------------------------
ELEVENLABS_API_KEY=
# Voix (Voice Library → choisir une voix française → "ID")
ELEVENLABS_VOICE_ID=
# Langues de l'assistant (fr toujours inclus) : fr,en,es,it,de,pt,ar,zh
AGENT_LANGUAGES=fr,en
# Modèle de langage utilisé par l'agent (liste dans ElevenLabs) — rapide de préférence
ELEVENLABS_LLM=claude-haiku-4-5
# Facultatif : rempli automatiquement si vide (l'agent est retrouvé par son nom)
ELEVENLABS_AGENT_ID=
# Facultatif : secret HMAC du webhook post-appel (affiché une fois par /setup)
ELEVENLABS_WEBHOOK_SECRET=
# Facultatif : hébergement européen des données (ex. https://api.eu.residency.elevenlabs.io)
ELEVENLABS_API_BASE=
# Durée de conservation des enregistrements d'appels (jours)
CALL_RETENTION_DAYS=90
# Numéro vers lequel l'IA transfère l'appel si le client veut parler à quelqu'un
HUMAN_TRANSFER_NUMBER=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio acheté (ex. +33 1 23 45 67 89)
TWILIO_PHONE_NUMBER=

# --- 6. Stockage (recommandé, gratuit) ----------------------------------------
# Upstash Redis (Vercel → Storage → Upstash) : anti-doublons fiable, verrou "Je prends la course"
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 7. Mentions légales (pages Mentions légales / CGV / Confidentialité) -----
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
# Numéro d'enregistrement / déclaration de centrale de réservation
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_LEGAL_INSURER=
NEXT_PUBLIC_LEGAL_MEDIATOR=

# --- Divers -------------------------------------------------------------------
# Mettre 1 sur un site de test pour empêcher Google de l'indexer
NEXT_PUBLIC_NOINDEX=
